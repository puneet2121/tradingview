//@version=6
// Local PineTS-compatible adaptation. OHLC simulation, not account orders.
// Position history uses a variable; five fixed-size brackets are submitted once.
strategy("Trend Breakdown Scalper - Local", overlay=true,
     default_qty_type=strategy.fixed, default_qty_value=1,
     process_orders_on_close=true, calc_on_every_tick=false)

grpTrend = "Trend filter"
fastLen = input.int(9, "Fast EMA length", minval=1, group=grpTrend)
slowLen = input.int(21, "Slow EMA length", minval=1, group=grpTrend)
trigLookback = input.int(20, "Breakout lookback (bars)", minval=1, group="Trigger")
stopLookback = input.int(10, "Stop swing lookback (bars)", minval=1, group="Risk management")
stopBufferTicks = input.int(4, "Stop buffer (ticks)", minval=0, group="Risk management")
entryQty = input.float(1, "Simulated quantity", minval=0.01, group="Risk management")

t1Ticks = input.int(6, "T1", minval=1, group="Profit targets (ticks from entry)")
t2Ticks = input.int(10, "T2", minval=1, group="Profit targets (ticks from entry)")
t3Ticks = input.int(16, "T3", minval=1, group="Profit targets (ticks from entry)")
t4Ticks = input.int(26, "T4", minval=1, group="Profit targets (ticks from entry)")
t5Ticks = input.int(38, "T5", minval=1, group="Profit targets (ticks from entry)")
allowLong = input.bool(true, "Allow longs", group="Trade direction")
allowShort = input.bool(true, "Allow shorts", group="Trade direction")
tick = syminfo.mintick
legQty = entryQty / 5

fastMA = ta.ema(close, fastLen)
slowMA = ta.ema(close, slowLen)
bullish = fastMA > slowMA
bearish = fastMA < slowMA
fastPlot = plot(fastMA, color=bullish ? color.green : color.red, title="Fast EMA")
slowPlot = plot(slowMA, color=color.new(color.gray, 40), title="Slow EMA")
fill(fastPlot, slowPlot, color=bullish ? color.new(color.green, 85) : color.new(color.red, 85), title="Trend cloud")

breakoutLevel = ta.highest(high, trigLookback)[1]
breakdownLevel = ta.lowest(low, trigLookback)[1]
plot(breakoutLevel, color=color.new(color.gray, 60), title="Breakout level")
plot(breakdownLevel, color=color.new(color.gray, 60), title="Breakdown level")
longTrigger = allowLong and bullish and close > breakoutLevel
shortTrigger = allowShort and bearish and close < breakdownLevel
plotshape(longTrigger, style=shape.triangleup, location=location.belowbar, color=color.green, size=size.tiny, title="Long trigger")
plotshape(shortTrigger, style=shape.triangledown, location=location.abovebar, color=color.red, size=size.tiny, title="Short trigger")

// PineTS cannot index strategy.position_size directly. Cache it as a series.
positionSize = strategy.position_size
flat = positionSize == 0
if longTrigger and flat
    strategy.entry("Long", strategy.long, qty=entryQty)
if shortTrigger and flat
    strategy.entry("Short", strategy.short, qty=entryQty)

rawLongStop = ta.lowest(low, stopLookback)[1] - stopBufferTicks * tick
rawShortStop = ta.highest(high, stopLookback)[1] + stopBufferTicks * tick
var float activeLongStop = na
var float activeShortStop = na
var float longEntryPrice = na
var float shortEntryPrice = na
justWentLong = positionSize > 0 and positionSize[1] == 0
justWentShort = positionSize < 0 and positionSize[1] == 0

if flat
    activeLongStop := na
    activeShortStop := na

// Fixed quantities keep each exit at 20% of the original size. Reissuing a
// filled bracket each bar in PineTS would incorrectly close that leg again.
if justWentLong
    activeLongStop := rawLongStop
    longEntryPrice := strategy.position_avg_price
    strategy.exit("T1-L", from_entry="Long", stop=activeLongStop, limit=longEntryPrice + t1Ticks * tick, qty=legQty, comment_profit="TP1", comment_loss="SL")
    strategy.exit("T2-L", from_entry="Long", stop=activeLongStop, limit=longEntryPrice + t2Ticks * tick, qty=legQty, comment_profit="TP2", comment_loss="SL")
    strategy.exit("T3-L", from_entry="Long", stop=activeLongStop, limit=longEntryPrice + t3Ticks * tick, qty=legQty, comment_profit="TP3", comment_loss="SL")
    strategy.exit("T4-L", from_entry="Long", stop=activeLongStop, limit=longEntryPrice + t4Ticks * tick, qty=legQty, comment_profit="TP4", comment_loss="SL")
    strategy.exit("T5-L", from_entry="Long", stop=activeLongStop, limit=longEntryPrice + t5Ticks * tick, qty=legQty, comment_profit="TP5", comment_loss="SL")

if justWentShort
    activeShortStop := rawShortStop
    shortEntryPrice := strategy.position_avg_price
    strategy.exit("T1-S", from_entry="Short", stop=activeShortStop, limit=shortEntryPrice - t1Ticks * tick, qty=legQty, comment_profit="TP1", comment_loss="SL")
    strategy.exit("T2-S", from_entry="Short", stop=activeShortStop, limit=shortEntryPrice - t2Ticks * tick, qty=legQty, comment_profit="TP2", comment_loss="SL")
    strategy.exit("T3-S", from_entry="Short", stop=activeShortStop, limit=shortEntryPrice - t3Ticks * tick, qty=legQty, comment_profit="TP3", comment_loss="SL")
    strategy.exit("T4-S", from_entry="Short", stop=activeShortStop, limit=shortEntryPrice - t4Ticks * tick, qty=legQty, comment_profit="TP4", comment_loss="SL")
    strategy.exit("T5-S", from_entry="Short", stop=activeShortStop, limit=shortEntryPrice - t5Ticks * tick, qty=legQty, comment_profit="TP5", comment_loss="SL")

plot(positionSize > 0 ? activeLongStop : positionSize < 0 ? activeShortStop : na, color=color.red, style=plot.style_circles, title="Active stop")

var table stats = table.new(position.top_right, 2, 5, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.new(color.gray, 40))
if barstate.islast
    totalTrades = strategy.closedtrades
    wins = strategy.wintrades
    winRatePct = totalTrades > 0 ? wins / totalTrades * 100.0 : 0.0
    avgWin = strategy.grossprofit / math.max(wins, 1)
    avgLoss = math.abs(strategy.grossloss) / math.max(totalTrades - wins, 1)
    ddPct = strategy.max_drawdown_percent
    table.cell(stats, 0, 0, "Closed legs", text_color=color.white, text_halign=text.align_left)
    table.cell(stats, 1, 0, str.tostring(totalTrades), text_color=color.white)
    table.cell(stats, 0, 1, "Win rate", text_color=color.white, text_halign=text.align_left)
    table.cell(stats, 1, 1, str.tostring(winRatePct, "#.#") + "%", text_color=color.white)
    table.cell(stats, 0, 2, "Avg win", text_color=color.white, text_halign=text.align_left)
    table.cell(stats, 1, 2, str.tostring(avgWin, "#.##"), text_color=color.white)
    table.cell(stats, 0, 3, "Avg loss", text_color=color.white, text_halign=text.align_left)
    table.cell(stats, 1, 3, str.tostring(avgLoss, "#.##"), text_color=color.white)
    table.cell(stats, 0, 4, "Max drawdown", text_color=color.white, text_halign=text.align_left)
    table.cell(stats, 1, 4, str.tostring(ddPct, "#.##") + "%", text_color=color.white)
